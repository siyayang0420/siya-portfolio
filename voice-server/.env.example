# Copy to voice-server/.env (never commit it) and fill in.

# OpenAI — the realtime voice agent
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# Twilio — places the call
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public address of this server (ngrok locally, the host in production). No trailing slash.
PUBLIC_BASE_URL=

# Guardrails
CALLS_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000,https://siyayang.xyz,https://www.siyayang.xyz
DAILY_CALL_CAP=5
PER_NUMBER_DAILY_CAP=1
CALL_TIME_LIMIT_S=150
# Extra tries you grant by hand, e.g. BONUS_NUMBERS=+17785550100,+16045550199
BONUS_NUMBERS=
